# Python分析API（backend/）のベースURL。
# 未設定の場合、Next.js側は開発用の固定ダミーデータで動作する（フォールバック）。
#
# ローカル開発: backend/README.md の手順でFastAPIサーバーを起動した上で
#   PYTHON_ANALYSIS_API_URL=http://localhost:8000
#
# Vercel等にデプロイする場合: 公開したPython APIのURL（例: Renderの場合
# https://<service-name>.onrender.com）を設定する。末尾のスラッシュは不要。
# 設定手順は docs/09_deployment.md を参照。
PYTHON_ANALYSIS_API_URL=

# 開発・検証用: trueにすると、分析フォーム上に「AI Overview取得モード
# （検証用）」というmock/off/dataforseo_sandbox/dataforseo_live（旧互換の
# dataforseoも選択可）の選択UIが表示される（app/components/BrandInputForm.tsx）。
# 未設定/false（デフォルト）では表示されず、既存の分析フォームの見た目・挙動は
# 変わらない。**これはUI表示用のフラグに過ぎず、これだけではDataForSEOは
# 実行できない。** 選択したaiOverviewModeはリクエストボディに含まれるだけで、
# 実際に上書きが適用されるかはPython API側の ALLOW_AI_OVERVIEW_MODE_OVERRIDE=true が
# 別途必要（下記参照）。dataforseo_liveに至っては、そこからさらに複数の
# 手動確認用ゲート（DATAFORSEO_LIVE_API_ENABLED等）がすべて揃わない限り
# 実行されない（dataforseo_sandboxはLiveゲート不要で常にSandboxへ接続する）。
# NEXT_PUBLIC_ プレフィックス付きのためクライアントに露出する（機密情報では
# ないため問題ない）。通常運用ではfalse推奨。
NEXT_PUBLIC_ENABLE_AI_OVERVIEW_MODE_SELECTOR=false

# 開発・検証用: trueにすると、分析フォーム上に「ChatGPT観測モード
# （検証用）」というoff/openaiの選択UIが表示される
# （app/components/BrandInputForm.tsx）。未設定/false（デフォルト）では
# 表示されない。**これもUI表示用のフラグに過ぎず、これだけではOpenAI APIは
# 実行できない。** 選択したchatgptModeはリクエストボディに含まれるだけで、
# 実際に上書きが適用されるかはPython API側の ALLOW_CHATGPT_MODE_OVERRIDE=true
# が別途必要（下記参照）。さらに、AI Overview取得モードがmockの場合は
# ChatGPT観測自体がスキップされる（既存mockの固定「ChatGPT」カードと重複
# させないため）。通常運用ではfalse推奨。
NEXT_PUBLIC_ENABLE_CHATGPT_MODE_SELECTOR=false

# 依頼者確認用ステージング環境（数ヶ月運用予定）の誤アクセス防止用パスコード。
# 未設定の場合、ローカル開発を妨げないようゲート自体が無効になる（proxy.ts参照）。
# Vercelにデプロイする場合のみ設定する。サーバー側でのみ参照する値であり、
# クライアントに露出しない（NEXT_PUBLIC_ プレフィックスを付けないこと）。
# 本格的な認証ではなく、誤アクセス・検索露出を減らすための最低限の保護。
# 設定手順は docs/09_deployment.md の「簡易パスコードガード」を参照。
STAGING_ACCESS_CODE=

# --- 以下はPython分析API（backend/）側の環境変数（Next.js側の.env.localではなく、
# backend/を起動する側 or Renderで設定する）。Next.js自体はこれらを参照しない。
# backend/README.md の「AI Overview比較のprovider mode」も参照。

# aiOverviewComparisonセクションのprovider切り替え（backend/services/ai_overview_provider.py）。
# mock（デフォルト・固定開発データ）/ off（セクション無効化） / dataforseo_sandbox
# （Liveゲート不要で常にDataForSEO SandboxへHTTP接続する。認証情報設定済みの場合のみ）
# / dataforseo_live（下記の5つの手動確認用ゲートがすべて揃った場合のみDataForSEO
# Live本番ホストへ接続する。1つでも欠ければ外部APIは一切呼ばれない） / dataforseo
# （env駆動の旧互換モード。DATAFORSEO_API_ENVの値でSandbox/Liveを切り替える。
# 明示的な切り替えには dataforseo_sandbox / dataforseo_live を推奨）。
# 通常運用では必ずmockのままにしておくこと。未設定時はmock。
AI_OVERVIEW_PROVIDER_MODE=mock

# true にした場合のみ、POST /analyzeのリクエストボディの `aiOverviewMode` フィールドで
# 上記のデフォルトを1リクエスト単位で上書きできるようにする（主にテスト用）。
# 未設定/false の場合、リクエストの `aiOverviewMode` は無視され、常に
# AI_OVERVIEW_PROVIDER_MODE の値が使われる。誤って費用が発生するモードを
# リクエストだけで有効化できないようにするための安全策。
# DataForSEO Live APIの手動確認時も、通常運用に戻すには
# AI_OVERVIEW_PROVIDER_MODE=mock のまま、これをtrueにしてリクエストボディで
# 一時的に aiOverviewMode="dataforseo_live" を明示する運用を推奨する
# （永続的なデフォルトをdataforseo_liveにしないため。dataforseo_liveを明示
# しても、下記の5つの手動確認用ゲートが揃っていなければ実行されない）。
ALLOW_AI_OVERVIEW_MODE_OVERRIDE=false

# --- DataForSEO関連（backend/services/dataforseo_settings.py、
# backend/services/dataforseo_client.py）。
# dataforseo mode + DATAFORSEO_API_ENV=sandbox + 認証情報設定済みの場合のみ、
# 実際にDataForSEO Sandbox（sandbox.dataforseo.com）へHTTP接続する。
# DATAFORSEO_API_ENV=live は、下記5条件（認証情報・DATAFORSEO_LIVE_API_ENABLED・
# DATAFORSEO_LIVE_CONFIRM_TEXT・DATAFORSEO_REQUEST_LIMIT_PER_ANALYZE・
# DATAFORSEO_API_ENV自体）がすべて揃った場合のみ、DataForSEO Live本番ホスト
# （api.dataforseo.com）へ1回だけ接続する「手動確認用」の経路であり、常時運用は
# 想定していない。1つでも欠けていれば外部APIは呼ばれず "unavailable" を返す。
# 値は絶対に本物をここ（.env.example）に書かないこと。実際の値はRenderの
# Environment Variablesにのみ設定し、GitHubにコミットしない・フロントエンドへは
# 渡さない。詳細は backend/README.md の「DataForSEO Sandbox/Live接続」、
# docs/07_decisions.md を参照。
#
# **DataForSEO Live APIは費用が発生する可能性がある。** 手動確認が終わったら、
# 必ず DATAFORSEO_API_ENV=sandbox（またはAI_OVERVIEW_PROVIDER_MODE=mock）に
# 戻すこと。このプロジェクトには確認後に自動でmock/sandboxへ戻す仕組みはない。

# DataForSEOアカウントの認証情報。login はメールアドレス形式のアカウントID、
# password はAPIパスワード。両方とも空欄のままで問題ない
# （未設定時は is_configured=false になり、dataforseo modeは
# 「credentials are not configured」という安全な理由文言のみを返す）。
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# DataForSEOのSandbox/Live切り替え。sandbox（デフォルト・テスト用、費用は
# 発生しない）/ live（本番相当、費用が発生し得る。下記の手動確認用ゲートが
# すべて揃っている場合のみ実際に接続する）。未設定・不正値はsandboxに
# フォールバックする。**通常運用では常にsandboxのままにしておくこと。**
# aiOverviewMode=dataforseo_sandboxはこの値に関わらず常にSandboxへ接続する
# （Liveゲート不要）。aiOverviewMode=dataforseo_liveを使う場合は、この値を
# 一時的にliveへ変更する必要がある（他の4ゲートと合わせて計5つすべてが
# 揃わない限り、それでもLiveへは接続しない）。
DATAFORSEO_API_ENV=sandbox

# true にした場合のみ、DATAFORSEO_API_ENV=live と組み合わせてLive APIを
# 使用する候補になる（他の手動確認用ゲートと合わせてすべて揃わない限り、
# 実際の呼び出しは発生しない）。未設定/falseならLive APIは絶対に使われない。
DATAFORSEO_LIVE_API_ENABLED=false

# DataForSEO Live APIを手動で1回だけ確認する際の確認文字列。通常は空欄のまま
# にしておく。Live手動確認時のみ、完全一致で ALLOW_DATAFORSEO_LIVE_ONCE を
# 設定する（大文字小文字・前後の空白を含め完全一致でなければ無効）。他の
# ゲート（DATAFORSEO_LIVE_API_ENABLED=true・DATAFORSEO_API_ENV=live・
# DATAFORSEO_REQUEST_LIMIT_PER_ANALYZE=1・認証情報設定済み）とすべて揃った
# 場合のみ、実際にDataForSEO Live本番ホストへの接続が許可される。
DATAFORSEO_LIVE_CONFIRM_TEXT=

# 1回の POST /analyze でDataForSEOへ投げてよい最大リクエスト数（Sandbox接続は
# 常に1リクエストのみ発行するため通常は未参照。DataForSEO Live手動確認を
# 許可するための必須ゲートの1つでもあり、この値が1でない場合はLiveへ接続
# しない）。未設定時は1。不正値・負の値は1に、上限（10）を超える値は10に
# フォールバックする。
DATAFORSEO_REQUEST_LIMIT_PER_ANALYZE=1

# dataforseo modeでリクエストするDataForSEO SERPエンドポイント。
# google_ai_mode_live_advanced（デフォルト・推奨。Sandboxで"Vercel"を検索した
# 際にai_overview項目を確実に返すことを手動確認済み）/
# google_organic_live_advanced（旧実装との互換用。ai_overview項目を確実には
# 返さないため非推奨）。未設定・不正値はgoogle_ai_mode_live_advancedに
# フォールバックする。エンドポイント名の"live"はDataForSEO独自の即時応答方式の
# 名称で、DATAFORSEO_API_ENV=sandbox/liveの環境選択とは別軸（Sandbox時は
# 常にsandbox.dataforseo.comへのみ接続する）。
DATAFORSEO_SERP_ENDPOINT=google_ai_mode_live_advanced

# DataForSEOへ送るSERPリクエストのlocation_code。未設定・不正値（整数変換
# できない）は2392（日本）にフォールバックする。
DATAFORSEO_LOCATION_CODE=2392

# DataForSEOへ送るSERPリクエストのlanguage_code。未設定・空文字はja
# にフォールバックする。
DATAFORSEO_LANGUAGE_CODE=ja

# DataForSEOへ送るSERPリクエストのdevice。desktop/mobileのみ許可。
# 未設定・不正値はdesktopにフォールバックする。
DATAFORSEO_DEVICE=desktop

# DataForSEOへ送るSERPリクエストのos。windows/macos/linux/android/iosを
# 想定（網羅的ではない）。未設定・不正値はwindowsにフォールバックする。
DATAFORSEO_OS=windows

# --- ChatGPT相当モデルの1問観測（OpenAI API、backend/services/chatgpt_settings.py、
# backend/services/chatgpt_client.py、backend/services/chatgpt_provider.py）。
# AI Overview比較セクションに、Google AI Mode/AI Overview（DataForSEO）とは
# 独立した「ChatGPT (OpenAI API)」観測カードを追加できる機能。
# **ChatGPTアプリそのものの内部認識を再現するものではない**——OpenAI API
# モデルに「このブランドは一般的にどう認識されるか」を1問だけ質問した結果を
# 表示するもの。Web検索は使わない（システムプロンプトで明示的に禁止）。
# 値は絶対に本物をここ（.env.example）に書かないこと。実際の値はRenderの
# Environment Variablesにのみ設定し、GitHubにコミットしない・フロントエンドへは
# 渡さない。詳細は backend/README.md の「ChatGPT相当モデルの1問観測」を参照。
#
# **OpenAI APIは費用が発生する可能性がある。** デフォルトは無効（off）。

# OpenAI APIキー。空欄のままで問題ない（未設定時は呼ばれず、安全な理由文言
# 「OpenAI API key is not configured.」のみ返す）。
OPENAI_API_KEY=

# ChatGPT観測のprovider切り替え。off（デフォルト・観測なし）/ openai
# （OpenAI APIへ実際に1回接続する。OPENAI_API_KEY設定済み・
# CHATGPT_REQUEST_LIMIT_PER_ANALYZE=1の場合のみ）。未設定・不正値はoffに
# フォールバックする。**通常運用では必ずoffのままにしておくこと。**
CHATGPT_PROVIDER_MODE=off

# true にした場合のみ、POST /analyzeのリクエストボディの `chatgptMode`
# フィールドで上記のデフォルトを1リクエスト単位で上書きできるようにする
# （主に検証用）。未設定/false の場合、リクエストの `chatgptMode` は無視され、
# 常に CHATGPT_PROVIDER_MODE の値が使われる。誤って費用が発生するモードを
# リクエストだけで有効化できないようにするための安全策。
ALLOW_CHATGPT_MODE_OVERRIDE=false

# OpenAI APIへ送るモデル名。未設定・空文字はgpt-5-miniにフォールバックする。
# gpt-5系モデル（gpt-5, gpt-5-mini等）を指定した場合、下記CHATGPT_TEMPERATURE
# はリクエストボディへ自動的に含めない（gpt-5系はtemperatureパラメータを
# 受け付けずHTTP 400になることが判明したため）。gpt-4.1系/gpt-4o系では
# 引き続きtemperatureが送信される。デモでの動作確認はgpt-4.1-miniで実施済み。
CHATGPT_MODEL=gpt-5-mini

# OpenAI APIのmax_output_tokens。100〜1500の範囲外・不正値は700に
# フォールバックする。
CHATGPT_MAX_OUTPUT_TOKENS=700

# 1回の POST /analyze でOpenAI APIへ投げてよい最大リクエスト数。1以外の値は
# （不正値へのフォールバックではなく）明示的なゲート失敗として扱われ、
# OpenAI APIは呼ばれない。未設定時は1。
CHATGPT_REQUEST_LIMIT_PER_ANALYZE=1

# ChatGPT観測回答のばらつきを抑えるための設定（temperature）。低いほど
# 回答が安定しやすく、デモ・検証用途では通常0.2を推奨する。許可範囲は
# 0.0〜1.0で、範囲外・不正値は0.2にフォールバックする。未設定時も0.2。
# この値は常に読み込まれ・バリデーションされるが、実際にOpenAI APIへ送る
# かどうかはCHATGPT_MODELに応じて決まる（applied to models that support
# temperature — it is omitted for gpt-5* models to avoid unsupported-
# parameter errors）。gpt-4.1系/gpt-4o系では送信され、gpt-5系（gpt-5,
# gpt-5-mini等）では送信されない（詳細はbackend/README.md参照）。
CHATGPT_TEMPERATURE=0.2

# --- Common Crawl最小連携（backend/services/common_crawl_settings.py、
# backend/services/common_crawl_index.py）。
# **2026-07-28時点ではCommon Crawl Index API検索のクライアントのみを実装済み。
# WARC本文取得・HTML抽出・Document[]化・/analyze統合・UI追加はまだ行っていない
# ——これらの環境変数は現時点では `/analyze` の挙動には一切影響しない。**
# 設計の全体像は docs/13_common_crawl_mvp_design.md を参照。
# Common Crawl Index API・WARCストレージはいずれも認証不要の公開データセット
# のため、secret（APIキー等）は不要。

# Common Crawl連携全体の大元のスイッチ（将来、providerレイヤーが実装された際に
# 参照する想定）。true/false。未設定時はfalse。**通常運用ではfalseのままに
# しておくこと。**
COMMON_CRAWL_ENABLED=false

# 検索対象のCommon Crawl index。`latest`（デフォルト、collinfo.jsonから最新の
# indexを解決する）または `CC-MAIN-YYYY-NN` 形式のindex idを明示指定できる。
# 不正な値は警告ログを出しつつ`latest`にフォールバックする。
COMMON_CRAWL_INDEX=latest

# 1回のdomain検索でCommon Crawl Index APIから取得するURL候補の上限。
# 1〜10の範囲で指定可能。範囲外・不正値は5にフォールバックする。
COMMON_CRAWL_MAX_RESULTS=5

# Common Crawl Index API（collinfo.json・Index検索の両方）へのリクエストの
# タイムアウト秒数。3〜30の範囲で指定可能。範囲外・不正値は10にフォールバック
# する。
COMMON_CRAWL_TIMEOUT_SECONDS=10

# Common Crawlへのリクエストに使うUser-Agent。空文字・200文字を超える値は
# デフォルト（AI-Visibility-Platform-MVP）にフォールバックする。
COMMON_CRAWL_USER_AGENT=AI-Visibility-Platform-MVP
